# GitHub Token (Requires repo, workflow, write:packages scopes)
GITHUB_TOKEN=ghp_your_github_token_here

# AI Model Provider Keys (Cascade fallback supported)
GEMINI_API_KEY=your_gemini_api_key_here
NVIDIA_API_KEY=nvapi-your_nvidia_nim_api_key_here
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Optional Webhook Secret for autonomous GitHub trigger
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Optional API Route Access Key (locks /api/agent behind x-api-key header)
DEVREL_AGENT_API_KEY=your_optional_agent_api_key_here
